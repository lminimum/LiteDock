# 应用配置
APP_NAME=LiteDock
APP_VERSION=1.0.0

# HTTP 服务器
HTTP_PORT=8080
HTTP_USE_PREFEXPEND_MODE=false

# 日志
LOG_LEVEL=debug

# 数据库配置
# 支持: sqlite | mysql | postgres
# DB_TYPE=sqlite
# DB_URL=./data.db

DB_TYPE=mysql
DB_URL=mysql://litedock:litedock@tcp(localhost:3306)/litedock

# DB_TYPE=postgres
# DB_URL=postgres://litedock:litedock@localhost:5432/litedock

# 连接池
DB_POOL_MAX=2

# 指标采集
METRICS_ENABLED=true

# Swagger 文档
SWAGGER_ENABLED=true
