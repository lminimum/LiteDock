APP_NAME=LiteDock
APP_VERSION=1.0.0

HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false

LOG_LEVEL=info

DB_TYPE=sqlite
DB_POOL_MAX=1
DB_URL=./data.db

# DB_TYPE=mysql
# DB_POOL_MAX=2
# DB_URL=mysql://user:password@tcp(localhost:3306)/litedock

# DB_TYPE=postgres
# DB_POOL_MAX=2
# DB_URL=postgres://user:password@localhost:5432/litedock

AUTH_JWT_SECRET=your-secret-key-at-least-32-chars

METRICS_ENABLED=true
SWAGGER_ENABLED=true

# AI Assistant Configuration
# Override defaults from opencode.json by setting these:
AI_API_ENDPOINT=https://api.lch.ink
AI_API_KEY=sk-your-key-here
AI_MODEL_NAME=MiniMax-M2.7
